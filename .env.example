# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase project → Connect → ORMs → Drizzle.
# Transaction pooler (port 6543), used by the app at runtime.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Optional. Session pooler (port 5432) for drizzle-kit migrations; if unset,
# DATABASE_URL is reused on port 5432.
DATABASE_URL_DIRECT=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Public origin, used for auth redirects and client portal links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs client portal links (/p/<token>). Generate with: openssl rand -base64 32
# Changing it invalidates every link already shared.
PORTAL_SECRET=

# Transactional email (sign-up confirmations, approvals). During the beta the
# same Gmail app password used for Supabase SMTP works. Unset → emails are logged.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Stüdyom <you@gmail.com>"

# Web Push (PWA notifications): npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:destek@studyom.app

# Scheduled jobs: call GET /api/cron with "Authorization: Bearer $CRON_SECRET" every 15 minutes.
CRON_SECRET=
