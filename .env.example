# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase project → Connect → ORMs → Drizzle.
# Transaction pooler (port 6543), used by the app at runtime.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Optional. Session pooler (port 5432) for drizzle-kit migrations; if unset,
# DATABASE_URL is reused on port 5432.
DATABASE_URL_DIRECT=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Public origin, used for auth redirects and client portal links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
